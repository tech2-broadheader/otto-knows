{
  "expo": {
    "name": "Otto",
    "slug": "otto",
    "version": "0.1.0",
    "scheme": "otto",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/otto-mascot.png",
    "splash": {
      "image": "./assets/otto-mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4FAF7"
    },
    "android": {
      "package": "com.broadheader.otto",
      "adaptiveIcon": {
        "foregroundImage": "./assets/otto-mascot.png",
        "backgroundColor": "#F4FAF7"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.broadheader.otto"
    },
    "plugins": ["expo-sqlite", "expo-web-browser", "expo-secure-store", "expo-font"]
  }
}
