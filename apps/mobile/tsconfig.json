{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@otto/schemas": [
        "../../packages/schemas/src/index.ts"
      ],
      "@otto/types": [
        "../../packages/types/src/index.ts"
      ],
