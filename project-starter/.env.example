# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any real secrets. .env.example holds keys only, no values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (only if using a direct connection / Prisma / Drizzle) ---
DATABASE_URL=

# --- Auth (only if using Auth.js instead of Supabase Auth) ---
# AUTH_SECRET=
# AUTH_URL=

# --- Payments (uncomment what this project uses) ---
# PAYMONGO_SECRET_KEY=
# PAYMONGO_PUBLIC_KEY=
# XENDIT_SECRET_KEY=
# ECPAY_MERCHANT_ID=

# --- Email ---
# RESEND_API_KEY=

# --- Analytics ---
# NEXT_PUBLIC_ANALYTICS_ID=
