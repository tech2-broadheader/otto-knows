# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any real secrets. .env.example holds keys only, no values.
# Read every variable through one typed config module (see CODING_CONVENTIONS §7).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Supabase (auth + entitlement, Pro tier; see docs/SETUP-supabase.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mobile uses the same project's URL + anon key (public-safe):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (direct connection for Drizzle migrations, server-side only) ---
DATABASE_URL=

# --- LLM brain (server-side ONLY — never expose to the client/mobile app) ---
# Keys live behind the Next.js LLM proxy; usage is metered per user. The provider
# is swappable — set LLM_PROVIDER, or just provide one key (see docs/SETUP-llm.md).
# With NO key configured, the brain degrades to the free/template experience.
LLM_PROVIDER=            # "anthropic" | "gemini" (optional; inferred from the key present)
# Anthropic (paid, most capable, best privacy posture):
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Google Gemini (has a free tier; review data-use terms before real finance/health data):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DEV-ONLY: set OTTO_DEV_AUTH=pro (never in production) to bypass the auth stub
# and exercise the LLM proxy locally as a Pro user, until real Supabase auth lands.
# OTTO_DEV_AUTH=pro

# --- Connectors ---
# Google Calendar / Google Tasks (OAuth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts stored Google tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# Health Connect (Android) / HealthKit (iOS) are device permissions, not env keys.

# --- Payments / subscriptions (uncomment what this project uses) ---
# PAYMONGO_SECRET_KEY=
# PAYMONGO_PUBLIC_KEY=
# XENDIT_SECRET_KEY=
# Store billing (RevenueCat) for mobile IAP / Lifetime SKU
# REVENUECAT_PUBLIC_SDK_KEY=
# Server webhook (story 9.5): the exact Authorization header value set in RevenueCat.
# REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_ENTITLEMENT_ID=pro
# Apply test (SANDBOX) purchases — never true in production.
# REVENUECAT_ALLOW_SANDBOX=false

# --- Email ---
# RESEND_API_KEY=

# --- Analytics (privacy-respecting, no sensitive-data fields) ---
# NEXT_PUBLIC_ANALYTICS_ID=
